{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "piko",
  "version": "0.2.0",
  "identifier": "local.piko.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "piko", "width": 1320, "height": 900, "minWidth": 780, "minHeight": 600, "backgroundColor": "#f5f7f9"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main-window"]
    }
  },
  "bundle": {"active": false, "targets": [], "icon": ["icons/icon.ico", "icons/icon.png"]}
}

